# Las claves que deploy/compose.yaml lee de deploy/.env. Aquí sin valores, a
# propósito: este archivo se versiona y el repositorio es público.
#
# No se llena a mano. deploy/generate-secrets.sh crea deploy/.env con un valor
# al azar para cada clave de esta lista, así que aquí van solo secretos.
#
# POSTGRES_PASSWORD       el superusuario de Postgres; solo para initdb y para
#                         una emergencia, nunca para la app.
# FINANCE_OWNER_PASSWORD  finance_owner, el dueño del esquema; con él migra Flyway.
# FINANCE_APP_PASSWORD    finance_app, con el que trabaja la API.
# API_TOKEN               el token de portador de la API.
POSTGRES_PASSWORD=
FINANCE_OWNER_PASSWORD=
FINANCE_APP_PASSWORD=
API_TOKEN=
