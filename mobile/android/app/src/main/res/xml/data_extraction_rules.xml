<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nada de la app sale en el respaldo a la nube ni en la
     transferencia a otro teléfono. allowBackup="false" apaga el respaldo, pero
     no la transferencia entre dispositivos; esto apaga las dos. Lo que se
     protege: la base local y lo que guarda el almacenamiento seguro. El
     servidor es la verdad: en un teléfono nuevo la app se vuelve a configurar
     y lee todo de allá. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </device-transfer>
</data-extraction-rules>
