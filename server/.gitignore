# Lo que genera el build de Gradle y las herramientas de Java. Vive aquí y no en
# la raíz para que ninguno de estos patrones alcance a mobile/.

.gradle
build/
!**/src/main/**/build/
!**/src/test/**/build/
# El wrapper sí se versiona: sin él, quien clone no puede construir.
!gradle/wrapper/gradle-wrapper.jar

# La caché de jqwik entre corridas de las propiedades del dominio.
.jqwik-database
*.class

